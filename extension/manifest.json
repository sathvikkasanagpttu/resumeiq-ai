{
  "manifest_version": 3,
  "name": "ResumeIQ - Instant Resume & Job Matcher",
  "version": "2.1.0",
  "description": "Evidence-first job matching, skill gap analysis, and tailored applications directly from any job post.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ResumeIQ Matcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.resumeiq.ai/*"
  ],
  "optional_host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "*://*.naukri.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.wellfound.com/*",
    "*://*.angel.co/*",
    "*://*.myworkdayjobs.com/*"
  ],
  "commands": {
    "match-job": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Trigger ResumeIQ match on current job post"
    }
  }
}
