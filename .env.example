# Application Environment: development, staging, production, testing
ENVIRONMENT=development

# Security: Required in production. Minimum 32-character random string.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars

# Database Configuration
POSTGRES_USER=resumeiq_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=resumeiq_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://resumeiq_user:replace_with_secure_postgres_password@localhost:5432/resumeiq_db
# For local dev without Postgres:
# DATABASE_URL=sqlite:///./resumeiq.db

# Redis & Async Task Queue
REDIS_URL=redis://localhost:6379/0

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Chrome Extension Origin (e.g., chrome-extension://<EXTENSION_ID>)
CHROME_EXTENSION_ID=your_chrome_extension_id_here

# Frontend Client API Base URL
VITE_API_URL=http://localhost:8000/api/v1
